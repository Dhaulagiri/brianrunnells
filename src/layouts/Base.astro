---
import '../styles/global.css';
import ProfileLinks from '../components/ProfileLinks.astro';
interface Props { title?: string; description?: string; }
const { title = 'Brian Runnells', description = 'Frontend platforms, design systems, and useful corners of the internet. The work and interests of Brian Runnells.' } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const active = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title === 'Brian Runnells' ? title : `${title} — Brian Runnells`}</title>
  <meta name="description" content={description} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={Astro.site ? new URL('/social-card.png', Astro.site).href : '/social-card.png'} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header wrap">
    <a class="wordmark" href="/" aria-current={active === '/' ? 'page' : undefined}>Brian Runnells</a>
    <nav aria-label="Main navigation">
      <a href="/#work">Work</a>
      <a href="/about/" aria-current={active.startsWith('/about') ? 'page' : undefined}>About</a>
      <a href="#connect">Connect</a>
    </nav>
  </header>
  <main id="main" tabindex="-1"><slot /></main>
  <footer class="site-footer wrap" id="connect">
    <div><h2>Keep in touch.</h2><p>Find me elsewhere on the internet.</p></div>
    <ProfileLinks />
    <p class="footer-note">Brian Runnells <span aria-hidden="true">·</span> Wisconsin</p>
    <a class="back-top" href="#main">Back to top ↑</a>
  </footer>
</body>
</html>

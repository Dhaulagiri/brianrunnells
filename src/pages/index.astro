---
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import Dock from '../components/Dock.astro';
import ProfileLinks from '../components/ProfileLinks.astro';
import Geocities from '../components/eras/Geocities.astro';
import Frontend from '../components/eras/Frontend.astro';
import ClimbingNarc from '../components/eras/ClimbingNarc.astro';
import Heroku from '../components/eras/Heroku.astro';
import HashiCorp from '../components/eras/HashiCorp.astro';
import Next from '../components/eras/Next.astro';
import { profile } from '../data/site';
---

<Base>
  <header class="site-intro">
    <div class="intro-bar">
      <h1>{profile.name}</h1>
      <ProfileLinks />
    </div>
    <div class="intro-summary">
      <p class="intro-bio">{profile.introduction}</p>
      <nav
        class="intro-actions"
        aria-label={profile.featuredWork.navigationLabel}
      >
        <a class="intro-case-study" href={profile.featuredWork.url}>
          {profile.featuredWork.label} <span aria-hidden="true">→</span>
        </a>
        <a class="intro-jump" href="#era-4">
          Jump to today <span aria-hidden="true">↓</span>
        </a>
      </nav>
    </div>
  </header>

  <div class="layout">
    <Rail />
    <main id="main" tabindex="-1">
      <Geocities />
      <Frontend />
      <ClimbingNarc />
      <Heroku />
      <HashiCorp />
      <Next />
    </main>
  </div>

  <Dock />

  <script>
    import '../scripts/moonrise';
  </script>
</Base>

<style>
  .site-intro {
    position: relative;
    isolation: isolate;
  }
  /* Put the case study beside the introduction so readers can find a concrete
     example before choosing whether to explore the whole timeline. */
  .intro-summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 10px 32px;
    margin-top: 10px;
  }
  .intro-bio {
    max-width: 58ch;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.55;
    text-wrap: pretty;
  }
  .intro-actions {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 100%;
    gap: 4px;
  }
  .intro-actions a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    max-width: 100%;
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.6;
  }
  .intro-case-study {
    min-height: 44px;
    padding: 8px 16px;
    border: 1px solid var(--accent);
    border-radius: 6px;
    background: var(--accent);
    color: var(--ink);
    text-decoration: none;
  }
  .intro-case-study:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .intro-jump {
    padding: 4px 0;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .intro-summary {
      grid-template-columns: minmax(0, 1fr);
      justify-items: start;
    }
    .intro-actions {
      grid-column: 1;
    }
    .intro-actions {
      grid-row: auto;
      margin-top: 4px;
    }
  }
</style>

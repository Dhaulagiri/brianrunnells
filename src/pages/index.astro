---
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import Dock from '../components/Dock.astro';
import ProfileLinks from '../components/ProfileLinks.astro';
import Geocities from '../components/eras/Geocities.astro';
import Frontend from '../components/eras/Frontend.astro';
import ClimbingNarc from '../components/eras/ClimbingNarc.astro';
import Heroku from '../components/eras/Heroku.astro';
import HashiCorp from '../components/eras/HashiCorp.astro';
import Next from '../components/eras/Next.astro';
import { profile } from '../data/site';
---

<Base>
  <header class="site-intro">
    <div class="intro-bar">
      <h1>{profile.name}</h1>
      <ProfileLinks />
    </div>
    <div class="intro-summary">
      <p class="intro-bio">{profile.introduction}</p>
      <a class="intro-jump" href="#era-4">
        Jump to today <span aria-hidden="true">↓</span>
      </a>
      <p class="intro-meta">{profile.introductionMeta}</p>
    </div>
  </header>

  <div class="layout">
    <Rail />
    <main id="main" tabindex="-1">
      <Geocities />
      <Frontend />
      <ClimbingNarc />
      <Heroku />
      <HashiCorp />
      <Next />
    </main>
  </div>

  <Dock />

  <script>
    import '../scripts/moonrise';
  </script>
</Base>

<style>
  .site-intro {
    position: relative;
    isolation: isolate;
  }
  /* Bio and shortcut share the first row; the signpost sits under the bio,
     so the eye goes name → what I do → the way out, in that order. */
  .intro-summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 10px 32px;
    margin-top: 10px;
  }
  .intro-bio {
    max-width: 58ch;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.55;
    text-wrap: pretty;
  }
  .intro-meta {
    grid-column: 1;
    color: var(--dim);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.02em;
  }
  /* This is the lede's escape hatch, so it reads as the one button here. */
  .intro-jump {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 8px 16px;
    border: 1px solid var(--accent);
    border-radius: 6px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--accent);
    text-decoration: none;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .intro-jump:hover {
    background: var(--accent);
    color: var(--ink);
    text-decoration: none;
  }
  @media (max-width: 720px) {
    .intro-summary {
      grid-template-columns: minmax(0, 1fr);
      justify-items: start;
    }
    .intro-meta,
    .intro-jump {
      grid-column: 1;
    }
    .intro-jump {
      grid-row: auto;
      margin-top: 4px;
    }
  }
</style>

---
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import Dock from '../components/Dock.astro';
import SocialPills from '../components/SocialPills.astro';
import Geocities from '../components/eras/Geocities.astro';
import Frontend from '../components/eras/Frontend.astro';
import ClimbingNarc from '../components/eras/ClimbingNarc.astro';
import Heroku from '../components/eras/Heroku.astro';
import HashiCorp from '../components/eras/HashiCorp.astro';
import Next from '../components/eras/Next.astro';
import { existsSync } from 'node:fs';
import { profile, heroImage } from '../data/site';

// The hero photograph is optional at build time: without it the hero falls
// back to its gradient rather than rendering a broken image.
const hasHeroPhoto = existsSync(new URL(`../../public${heroImage.src}`, import.meta.url));
---
<Base>
  <header class="hero">
    {hasHeroPhoto && (
      <img
        class="hero-photo"
        src={heroImage.src}
        alt={heroImage.alt}
        fetchpriority="high"
        decoding="async"
      />
    )}
    <div class="hero-scrim" aria-hidden="true"></div>

    <div class="hero-bar">
      <p class="hero-wordmark">{profile.name}</p>
      <p class="hero-place">{profile.place}</p>
    </div>

    <div class="hero-body">
      <h1>{profile.headline} <em>{profile.headlineAccent}</em></h1>
      <div class="hero-footer">
        <p class="hero-intro">{profile.introduction}</p>
        <div class="hero-actions">
          <SocialPills variant="glass" />
          <a class="hero-start" href="#era-0">Start in the 1990s <span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </div>
  </header>

  <div class="layout">
    <Rail />
    <main id="main" tabindex="-1">
      <Geocities />
      <Frontend />
      <ClimbingNarc />
      <Heroku />
      <HashiCorp />
      <Next />
    </main>
  </div>

  <Dock />

  <script>
    import '../scripts/moonrise';
  </script>
</Base>

---
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import Dock from '../components/Dock.astro';
import ProfileLinks from '../components/ProfileLinks.astro';
import Moon from '../components/Moon.astro';
import Geocities from '../components/eras/Geocities.astro';
import Frontend from '../components/eras/Frontend.astro';
import ClimbingNarc from '../components/eras/ClimbingNarc.astro';
import Heroku from '../components/eras/Heroku.astro';
import HashiCorp from '../components/eras/HashiCorp.astro';
import Next from '../components/eras/Next.astro';
import { profile } from '../data/site';
---
<Base>
  <header class="site-intro">
    <div class="intro-moon" aria-hidden="true"><Moon size="144px" glow={0} phase={0.35} textured /></div>
    <div class="intro-bar">
      <h1>{profile.name}</h1>
      <ProfileLinks />
    </div>
    <div class="intro-summary">
      <p>Frontend engineering &amp; design at HashiCorp, now part of IBM.</p>
      <a href="#era-4">Jump to today <span aria-hidden="true">↓</span></a>
    </div>
  </header>

  <div class="layout">
    <Rail />
    <main id="main" tabindex="-1">
      <Geocities />
      <Frontend />
      <ClimbingNarc />
      <Heroku />
      <HashiCorp />
      <Next />
    </main>
  </div>

  <Dock />

  <script>
    import '../scripts/moonrise';
  </script>
</Base>

<style>
  .site-intro { position: relative; isolation: isolate; overflow: hidden; }
  .intro-moon {
    position: absolute;
    z-index: -1;
    top: 50%;
    right: 20%;
    transform: translateY(-50%);
    opacity: 0.1;
    pointer-events: none;
  }
  .intro-summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    margin-top: 4px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }
  .intro-summary p { max-width: 560px; text-wrap: pretty; }
  .intro-summary a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 6px 12px;
    border: 1px solid var(--edge);
    border-radius: 6px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accent);
    text-decoration: none;
  }
  .intro-summary a:hover { background: #1c1e26; }
  @media (max-width: 560px) {
    .intro-summary { gap: 12px; margin-top: 8px; }
    .intro-summary p { font-size: 13px; }
    .intro-summary a { padding-inline: 8px; font-size: 11px; }
  }
</style>

---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/site';
export function getStaticPaths() { return projects.map(project => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
const next = projects[(projects.findIndex(item => item.slug === project.slug) + 1) % projects.length];
---
<Base title={project.title} description={project.summary}>
  <article class="article wrap work-detail">
    <header class="article-header"><a class="back-link" href="/#work">← Selected work</a><p class="article-label">{project.kicker}</p><h1>{project.title}</h1><p class="detail-deck">{project.summary}</p><dl class="project-meta"><dt>My role</dt><dd>{project.role}</dd><dt>Explore</dt><dd><a href={project.url}>Visit {project.title} <span aria-hidden="true">↗</span></a></dd></dl></header>
    <div class="prose">{project.sections.map(section => <section><h2>{section.title}</h2>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}</section>)}</div>
    <aside class="next-work"><span>Another part of the story</span><a href={`/work/${next.slug}/`}>{next.title} →</a></aside>
  </article>
</Base>

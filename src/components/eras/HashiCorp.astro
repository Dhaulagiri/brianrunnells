---
import Icon from '../Icon.astro';
import { hashicorp as era } from '../../data/site';
---
<section id="era-4" class="era era-hashicorp" data-era="4" aria-labelledby="era-4-heading">
  <div class="era-inner" data-reveal>
    <h2 class="era-kicker" id="era-4-heading">{era.kicker}</h2>

    <div class="hc-columns">
      <div class="hc-intro">
        <div class="hc-brand">
          <span class="hc-logo" role="img" aria-label="Helios">
            <Icon name="helios" /><Icon name="helios-wordmark" />
          </span>
          <span class="hc-badge"><span class="hc-dot" aria-hidden="true"></span>{era.badge}</span>
        </div>

        <p class="hc-body">{era.body}</p>

        <ul class="hc-actions">
          {era.actions.map((action) => (
            <li>
              <a href={action.url} rel="noopener" class={action.primary ? 'is-primary' : undefined}>
                {!action.primary && <Icon name="github" />}{action.label}<span aria-hidden="true"> ↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="hc-panel">
        <ul class="hc-tabs" aria-hidden="true">
          {era.tabs.map((tab, index) => <li class={index === 0 ? 'is-current' : undefined}>{tab}</li>)}
        </ul>
        <div class="hc-panel-body">
          <div class="hc-callout">
            <span class="hc-callout-mark" aria-hidden="true"></span>
            <p><b>{era.callout.title}</b><br />{era.callout.body}</p>
          </div>
          <ul class="hc-tags">
            {era.badges.map((badge) => (
              <li style={`background:${badge.background};color:${badge.color};`}>{badge.text}</li>
            ))}
          </ul>
          <p class="hc-toggle">
            <span>{era.toggle}</span>
            <span class="hc-switch" aria-hidden="true"></span>
          </p>
          <ul class="hc-tokens">
            {era.tokens.map((token) => (
              <li>
                <span class="hc-swatch" style={`background:${token.swatch};`} aria-hidden="true"></span>
                {token.name}{token.note && <span class="hc-note"> {token.note}</span>}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

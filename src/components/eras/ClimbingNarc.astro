---
import { climbingnarc as era } from '../../data/site';
---

<section
  id="era-2"
  class="era era-climbingnarc"
  data-era="2"
  aria-labelledby="era-2-kicker era-2-heading"
>
  <div class="era-inner" data-reveal>
    <p class="era-kicker" id="era-2-kicker">
      {era.kicker}
    </p>

    <div class="cn-window">
      <div class="cn-masthead">
        <div class="cn-brand">
          <img
            src={era.logo.src}
            alt={era.logo.alt}
            width="52"
            height="52"
            loading="lazy"
            decoding="async"
          />
          <div>
            <h2 class="cn-wordmark" id="era-2-heading">
              Climbing <span>Narc</span>
            </h2>
            <p class="cn-tagline">{era.tagline}</p>
          </div>
        </div>
        <ul class="cn-nav" aria-label="ClimbingNarc archive links">
          {era.nav.map((item) => (
            <li>
              <a
                href={
                  item === 'News'
                    ? era.url
                    : `${era.url}?s=${encodeURIComponent(item === 'Comps' ? 'competition' : item)}`
                }
              >
                {item === 'About' ? 'About search' : item}
              </a>
            </li>
          ))}
          <li class="cn-rss">
            <a href="https://climbingnarc.com/feed/">RSS</a>
          </li>
        </ul>
      </div>

      <div class="cn-body">
        {era.posts.map((post) => (
          <article class="cn-post">
            <p class="cn-meta">{post.meta}</p>
            <h3 class="cn-post-title">{post.title}</h3>
            <p>{post.body}</p>
          </article>
        ))}
        <div class="cn-interviews">
          <h3 class="cn-post-title">On the other side of the questions</h3>
          <ul>
            {era.interviews.map((interview) => (
              <li>
                <a href={interview.url}>{interview.title}</a>
                <span class="cn-meta">
                  {interview.publication} · {interview.year}
                </span>
              </li>
            ))}
          </ul>
        </div>
        <p class="cn-cta">
          <a href={era.url} rel="noopener">
            {era.cta}
          </a>
          <span class="cn-stats">{era.stats}</span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .cn-nav {
    flex-wrap: wrap;
  }
  .cn-nav a {
    color: #fffdf8;
    display: inline-block;
    min-width: 24px;
    min-height: 24px;
    padding: 4px 0;
    text-decoration: underline;
  }
  .cn-rss a {
    color: #231c14;
  }
</style>

<style>
  .cn-interviews {
    margin-block: 14px;
  }
  .cn-interviews ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 9px;
  }
  .cn-interviews a {
    display: inline-block;
    min-height: 24px;
    padding-block: 4px;
    color: #67400a;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cn-interviews .cn-meta {
    display: block;
    margin: 0;
  }
</style>

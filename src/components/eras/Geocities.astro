---
import { geocities as era } from '../../data/site';
---
<section id="era-0" class="era era-geocities" data-era="0" aria-labelledby="era-0-heading">
  <div class="era-inner" data-reveal>
    <h2 class="era-kicker" id="era-0-heading">{era.kicker}</h2>

    <div class="gc-marquee">
      <span class="gc-marquee-track"><span data-marquee>{era.marquee}</span></span>
      <button type="button" class="gc-marquee-pause" data-marquee-pause hidden aria-pressed="false">
        Pause
      </button>
    </div>

    <p class="gc-title">{era.title}</p>

    <div class="gc-rule" aria-hidden="true"></div>

    <div class="gc-columns">
      <div class="gc-panel">
        <b>MY LINKS</b>
        <ul>{era.links.map((link) => <li><u>{link}</u></li>)}</ul>
        <p class="gc-visitor-label">You are visitor #</p>
        <p class="gc-visitor">{era.visitorCount}</p>
      </div>
      <div class="gc-body">
        {era.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>

    <hr class="gc-hr" />

    <div class="gc-footer">
      <p class="gc-webring">
        [ &lt;&lt; prev | <u>{era.webring}</u> | random | next &gt;&gt; ]
      </p>
      <ul class="gc-badges">
        {era.badges.map((badge) => (
          <li style={`background:${badge.background};color:${badge.color};`}>{badge.text}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

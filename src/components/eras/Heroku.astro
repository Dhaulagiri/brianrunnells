---
import Icon from '../Icon.astro';
import { heroku as era } from '../../data/site';
---

<section
  id="era-3"
  class="era era-heroku"
  data-era="3"
  aria-labelledby="era-3-kicker era-3-heading"
>
  <div class="era-inner" data-reveal>
    <p class="era-kicker" id="era-3-kicker">
      {era.kicker}
    </p>

    <p class="hk-brand" role="img" aria-label="Heroku">
      <Icon name="heroku" />
      <span class="hk-wordmark">Heroku</span>
    </p>

    <h2 class="hk-headline" id="era-3-heading">
      {era.headline}
    </h2>
    <p class="hk-body">{era.body}</p>

    <div class="hk-panel">
      <div class="hk-tabs">
        <ul aria-label="Play with the dashboard">
          {era.tabs.map((tab, index) => (
            <li class={index === 0 ? 'is-current' : undefined}>
              <button
                type="button"
                data-heroku-view={tab}
                disabled
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                {tab}
              </button>
            </li>
          ))}
        </ul>
        <p class="hk-scope">{era.scope}</p>
      </div>

      <p class="hk-demo" data-heroku-status role="status" hidden></p>
      <div class="hk-columns" data-heroku-overview>
        <div class="hk-column">
          <p class="hk-column-title">Dyno formation</p>
          <p class="hk-dyno">
            <span class="hk-dyno-name">{era.dynos.primary.name}</span>
            <span class="hk-dyno-blocks" aria-hidden="true">
              {Array.from({ length: era.dynos.primary.total }, (_, index) => (
                <span
                  class={
                    index < era.dynos.primary.running ? 'is-on' : undefined
                  }
                ></span>
              ))}
            </span>
          </p>
          <p class="hk-dyno">
            <span class="hk-dyno-name">night-ride</span>
            <span class="hk-dyno-status">● {era.dynos.nightRide}</span>
          </p>
          <div class="hk-chart" aria-hidden="true">
            {era.chart.map((height) => (
              <span style={`height:${height}%;`}></span>
            ))}
          </div>
        </div>

        <div class="hk-column">
          <p class="hk-column-title">Latest activity</p>
          <ul class="hk-activity">
            {era.activity.map((entry) => (
              <li>
                <b>{entry.actor}</b> {entry.text}
                {entry.code && (
                  <>
                    {' '}
                    <code>{entry.code}</code> {entry.suffix}
                  </>
                )}
              </li>
            ))}
          </ul>
          <div class="hk-terminal">
            <p class="hk-command">{era.terminal.command}</p>
            <p class="hk-lesson">{era.terminal.lesson}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hk-body {
    max-width: 640px;
    font-size: 17px;
    line-height: 1.6;
    margin-bottom: 24px;
  }
  .hk-tabs ul {
    flex-wrap: wrap;
    gap: 8px 16px;
  }
  .hk-tabs button {
    background: transparent;
    border: 0;
    color: inherit;
    font: inherit;
    padding: 4px 0;
    min-height: 28px;
    cursor: pointer;
  }
  .hk-demo {
    padding: 24px;
    color: #352c5c;
    line-height: 1.6;
  }
  [hidden] {
    display: none !important;
  }
</style>

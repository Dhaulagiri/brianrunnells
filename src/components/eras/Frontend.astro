---
import { frontend as era } from '../../data/site';
---
<section id="era-1" class="era era-frontend" data-era="1" aria-labelledby="era-1-heading">
  <div class="era-inner" data-reveal>
    <h2 class="era-kicker" id="era-1-heading">{era.kicker}</h2>

    <div class="fe-window">
      <div class="fe-titlebar">
        <p class="fe-filename">brian runnells <span>:: {era.filename}</span></p>
        <p class="fe-modified">{era.modified}</p>
      </div>
      <div class="fe-body">
        <p class="fe-summary">{era.summary}</p>

        <table class="fe-table">
          <thead>
            <tr><th scope="col">Company</th><th scope="col">Role</th><th scope="col">Years</th></tr>
          </thead>
          <tbody>
            {era.roles.map((role) => (
              <tr>
                <td>{role.company}</td>
                <td>{role.role}</td>
                <td class="fe-years">{role.years}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <ul class="fe-badges">
          {era.badges.map((badge) => (
            <li style={`--badge-accent:${badge.accent};`}>
              <span class="fe-badge-prefix">{badge.prefix}</span><span class="fe-badge-text">{badge.text}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

---
import { eras } from '../data/site';

/**
 * The timeline as a lunation: one moon per era, waxing from new to full, each
 * labelled with what that era was. All six share a single WebGL canvas rather
 * than one context each — the shader splits it into cells — so the strip costs
 * the page one context instead of six.
 *
 * Without WebGL the canvas draws nothing and the labels stand on their own,
 * which is why they carry the era name rather than relying on the moons.
 */
---
<nav class="phase-strip" aria-label="Timeline">
  <canvas class="phase-strip-canvas" data-moon-gl data-moon-cells={eras.length} aria-hidden="true"></canvas>
  <ol class="phase-strip-list">
    {eras.map((era) => (
      <li>
        <a href={`#${era.id}`}>
          <span class="phase-strip-name">{era.name}</span>
          <span class="phase-strip-years">{era.years}</span>
          <span class="phase-strip-hint">{era.hint}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>

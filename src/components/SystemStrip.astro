---
/* The closing argument of the case study, made structurally rather than in
   prose: every rule used to set the page above is declared once, named the way
   Helios names things, and then shown.

   The specimens are drawn with the same custom properties the page itself
   uses — not with copies of their values — so this cannot drift from the page
   it documents. Which is, more or less, the whole thesis. */
import { heliosSystemStrip as strip } from '../data/site';
---

<section class="strip" aria-labelledby="strip-title">
  <div class="case-aside">
    <p class="case-label">{strip.label}</p>
  </div>

  <div class="strip-body">
    <h2 id="strip-title">{strip.heading}</h2>
    <p class="strip-lede">{strip.body}</p>

    {strip.groups.map((group) => (
      <div class="strip-group">
        <p class="strip-group-label">{group.label}</p>
        <ul class="strip-list" role="list">
          {group.tokens.map((token) => (
            <li>
              <span class={`strip-specimen is-${group.kind}`}>
                <span style={`--specimen:var(${token.name})`}>
                  {group.kind === 'type' ? 'Ag' : ''}
                </span>
              </span>
              <code>{token.name}</code>
              <span class="strip-use">{token.use}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <a class="case-source" href={strip.link.url}>
      {strip.link.label} <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<style>
  .strip {
    display: grid;
    grid-template-columns: minmax(200px, 1fr) minmax(0, 2.8fr);
    gap: var(--token-space-24) 48px;
    padding-block: var(--token-space-52);
    border-top: 1px solid var(--token-color-border-primary);
  }
  /* The aside and label are the page's, but scoped styles do not cross a
     component boundary, so the two rules are restated here against the same
     tokens. */
  .case-aside {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-content: start;
  }
  .case-label {
    color: var(--token-color-foreground-faint);
    font: var(--token-typography-code-100);
    letter-spacing: 0.03em;
  }
  .case-source {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    gap: 8px;
    color: var(--token-color-foreground-action);
    font-size: 12px;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  h2 {
    font: var(--token-typography-display-500);
    letter-spacing: -0.015em;
    margin-bottom: 24px;
    max-width: 20ch;
    text-wrap: pretty;
  }
  .strip-lede {
    max-width: 62ch;
    font: var(--token-typography-body-300);
  }
  .strip-group {
    margin-top: 32px;
  }
  .strip-group-label {
    font: var(--token-typography-code-100);
    letter-spacing: 0.03em;
    color: var(--token-color-foreground-action);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--token-color-border-primary);
  }
  .strip-list li {
    display: grid;
    grid-template-columns: 40px minmax(0, 27ch) minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    padding-block: 10px;
    border-bottom: 1px solid var(--token-color-border-primary);
  }
  .strip-specimen {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 28px;
  }
  /* Each specimen is painted with the live property, never with a copy of its
     value, so the row below is always telling the truth about the page above. */
  .is-color span {
    display: block;
    width: 28px;
    height: 28px;
    border-radius: 3px;
    border: 1px solid var(--token-color-border-primary);
    background: var(--specimen);
  }
  .is-space span {
    display: block;
    height: 10px;
    width: var(--specimen);
    min-width: 2px;
    background: var(--token-color-foreground-action);
    border-radius: 2px;
  }
  .is-type span {
    font: var(--specimen);
    color: var(--token-color-foreground-strong);
    line-height: 1;
  }
  .strip-list code {
    font: var(--token-typography-code-100);
    color: var(--token-color-foreground-primary);
    overflow-wrap: anywhere;
  }
  .strip-use {
    font-size: 13px;
    line-height: 1.6;
    color: var(--token-color-foreground-faint);
  }
  .strip .case-source {
    margin-top: 28px;
  }
  @media (max-width: 620px) {
    .strip {
      grid-template-columns: 1fr;
      gap: 16px;
      padding-block: 36px;
    }
    .strip-list li {
      grid-template-columns: 40px minmax(0, 1fr);
      row-gap: 4px;
    }
    .strip-use {
      grid-column: 2;
    }
  }
</style>

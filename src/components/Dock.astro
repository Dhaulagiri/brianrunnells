---
import Moon from './Moon.astro';
import { eras } from '../data/site';
---

<nav class="dock" aria-label="Timeline" aria-describedby="dock-scroll-help">
  <Moon size="28px" glow={20} />
  <ol class="dock-list">
    {eras.map((era) => (
      <li>
        <a href={`#${era.id}`} data-era-link={era.id}>
          {era.name}
        </a>
      </li>
    ))}
  </ol>
  <span class="dock-scroll-cue" aria-hidden="true">
    ↔
  </span>
  <span id="dock-scroll-help" class="sr-only">
    Scroll horizontally for more eras. Tab through the links to navigate by
    keyboard.
  </span>
</nav>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .dock-scroll-cue {
    flex: none;
    color: #d4d5da;
    font-size: 24px;
    line-height: 1;
  }
  .dock-scroll-cue[hidden] {
    display: none;
  }
  /* Leave room for the outline inside the scrolling viewport. */
  .dock-list {
    padding: 4px;
  }
</style>
